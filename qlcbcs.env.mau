# Cấu hình QL CBCS LAN — sao chép thành qlcbcs.env và sửa giá trị.
# Script trien_khai\windows\cai_dat.ps1 tự tạo qlcbcs.env với khoá bí mật ngẫu nhiên.
# Chỉ tài khoản chạy dịch vụ và quản trị được đọc tệp này (chứa mật khẩu CSDL).

QLCBCS_CHE_DO=san_xuat
QLCBCS_SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-it-nhat-40-ky-tu
QLCBCS_DEBUG=0

# Tên hiển thị trên đầu trang quản trị (thay "Trang quản trị cho Django"). Sửa xong khởi động lại máy chủ.
QLCBCS_TEN_HE_THONG=QL CBCS LAN

# Tên máy và địa chỉ IP mà người dùng gõ vào trình duyệt, cách nhau bằng dấu phẩy.
QLCBCS_ALLOWED_HOSTS=localhost,127.0.0.1,MAY-CHU-QLCBCS,192.168.1.10

QLCBCS_DB_NAME=qlcbcs
QLCBCS_DB_USER=qlcbcs
QLCBCS_DB_PASSWORD=thay-mat-khau-csdl
QLCBCS_DB_HOST=127.0.0.1
QLCBCS_DB_PORT=5432

# Máy chủ Waitress
QLCBCS_DIA_CHI=0.0.0.0
QLCBCS_CONG=8000
QLCBCS_SO_LUONG=8

# Thư mục (bỏ dấu # để đổi; mặc định nằm trong thư mục cài đặt)
# QLCBCS_THU_MUC_TINH=C:\QLCBCS\staticfiles
# QLCBCS_THU_MUC_NHAT_KY=C:\QLCBCS\nhat_ky

# Chỉ bật khi có HTTPS phía trước (IIS/reverse proxy), kèm địa chỉ https:
# QLCBCS_HTTPS=1
# QLCBCS_SAU_PROXY=1
# QLCBCS_CSRF_TRUSTED_ORIGINS=https://qlcbcs.donvi.local
